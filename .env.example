# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://padapi.sksu-orms.net
APP_KEY=replace-with-a-long-random-secret-before-deploying
# Set the exact production frontend origin from Vercel > pad-web > Domains.
# Example format: https://your-project.vercel.app (no trailing slash or path).
# Leave blank until the actual frontend address has been verified.
APP_ALLOWED_ORIGINS=

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pad_db
DB_USERNAME=pad_user
DB_PASSWORD=replace-with-a-strong-database-password

# Google Identity Services
# Create a Google Cloud OAuth 2.0 Web client. This ID is public but must match the API verifier.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Google sign-in allow-list
# tblaccount is never changed by PAD. A Google email must already exist in this column to sign in.
AUTH_ACCOUNT_TABLE=tblaccount
AUTH_ACCOUNT_EMAIL_COLUMN=acc_email

# Optional: this approved email is created as the first PAD administrator.
FIRST_ADMIN_EMAIL=

# Legacy OVP office defaults used when preserving existing assignments during setup.
# New OVP assignments are selected and saved in Administration > User accounts.
PAD_OVP_PAD_OFFICE_ID=3
PAD_CENTRAL_RECORDS_OFFICE_ID=2

# Private storage outside public; deployment preserves existing files.
UPLOAD_PATH=storage/documents
MAX_UPLOAD_BYTES=10485760
